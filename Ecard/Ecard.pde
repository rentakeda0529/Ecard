// ========================================
// Eカード
// ========================================

// ========================================
// ゲームの状態
// ========================================

// 現在の陣営
String side = "";

// プレイヤーと相手のカード
String[] playerCards;
String[] enemyCards;

// カードを使用したかどうか
boolean[] playerUsed;
boolean[] enemyUsed;

// 現在選択しているカード
int playerCard = -1;

// 自分が出したカード
int playerShownCard = -1;

// 相手が出したカード
int enemyCard = -1;

// 現在のラウンド
int round = 0;

// 勝利数
int playerWin = 0;
int enemyWin = 0;

// 引き分け数
int drawCount = 0;

// 勝敗結果
String result = "";

// ========================================
// 初期設定
// ========================================

void setup() {

  // 画面サイズ
  size(800, 600);

  // 文字を中央揃え
  textAlign(CENTER, CENTER);

  // フォントを設定
  PFont font = createFont("SansSerif", 32);
  textFont(font);
}

// ========================================
// メイン処理
// ========================================

void draw() {

  // 背景
  background(25, 25, 30);

  // 陣営がまだ決まっていない場合
  if (side.equals("")) {

    // 陣営選択画面
    drawSideSelect();

  } else {

    // ゲーム画面
    drawGame();
  }
}

// ========================================
// 陣営選択画面
// ========================================

void drawSideSelect() {

  // タイトル
  fill(255, 210, 60);
  textSize(48);
  text("Eカード", width / 2, 80);

  // 説明
  fill(255);
  textSize(28);
  text("どちらの陣営で戦いますか？",width / 2,170);
  rectMode(CENTER);

  // ========================================
  // 皇帝側ボタン
  // ========================================

  fill(120, 40, 40);
  
  rect(250,320,220,100,15);

  fill(255);
  textSize(32);

  text("皇帝側",250,320);

  // ========================================
  // 奴隷側ボタン
  // ========================================

  fill(40, 60, 120);

  rect(550,320,220,100,15);

  fill(255);
  textSize(32);

  text("奴隷側",550,320);

  // 操作説明
  fill(180);
  textSize(16);

  text("左クリックして陣営を選択",width / 2,450);
}

// ========================================
// ゲーム画面
// ========================================

void drawGame() {

  // ========================================
  // タイトル
  // ========================================

  fill(255, 210, 60);
  textSize(40);

  text("Eカード",width / 2,35);

  // 現在の陣営
  fill(255);
  textSize(18);

  text("あなた：" + side,width / 2,65);

  // ラウンド数
  textSize(20);

  text("ROUND " + round + " / 5",width / 2,95);

  // ========================================
  // ゲーム終了画面
  // ========================================

  if (round >= 5) {

    fill(255);
    textSize(36);

    // 最終勝敗
    if (playerWin > enemyWin) {
      text("YOU WIN!",width / 2,200);
    } else if (playerWin < enemyWin) {
      text("YOU LOSE...",width / 2,200);
    } else {
      text("DRAW",width / 2,200);
    }

    // ========================================
    // 最終スコア
    // ========================================

    textSize(24);

    text("あなた " + playerWin +" - " + enemyWin + 
    " 相手    DRAW " + drawCount,width / 2,250);

    // ========================================
    // 最後に出したカード
    // ========================================

    fill(230);
    textSize(20);

    text("最後に出したカード",width / 2,310);

    // 最後に出したカードがある場合
    if (playerShownCard != -1) {
      drawCard(
        playerCards[playerShownCard],
        width / 2,370,130,75);
    }

    // ========================================
    // 最初の画面に戻るボタン
    // ========================================

    rectMode(CENTER);

    fill(100);

    rect(width / 2,500,220,55,10);

    fill(255);
    textSize(18);

    text("最初の画面に戻る",width / 2,500);

    return;
  }

  // ========================================
  // 相手のカード
  // ========================================

  fill(230);
  textSize(20);

  text("相手",width / 2,125);

  // 相手のカードが決まっている場合
  if (enemyCard != -1) {

    drawCard(enemyCards[enemyCard],width / 2,185,130,75);
  } else {

    // まだ決まっていない場合は裏向き
    drawBack(width / 2,185,130,75);
  }

  // ========================================
  // 勝敗結果
  // ========================================

  fill(255, 210, 60);
  textSize(30);

  text(result,width / 2,280);

  // ========================================
  // 現在のスコア
  // ========================================

  fill(255);
  textSize(20);

  text("あなた " + playerWin + " - " + enemyWin +
    " 相手    DRAW " + drawCount, width / 2,315);

  // ========================================
  // 自分が出したカード
  // ========================================

  fill(230);
  textSize(18);

  text("あなたが出したカード",width / 2,350);

  // 出したカードがある場合
  if (playerShownCard != -1) {

    drawCard(
      playerCards[playerShownCard],
      width / 2,395,120,60);
  }

  // ========================================
  // 手札
  // ========================================

  fill(230);
  textSize(18);

  text("あなたの手札",width / 2,460);

  // 手札を表示
  drawPlayerCards();

  // ========================================
  // 操作説明
  // ========================================

  fill(255);
  textSize(16);

  // カードがまだ選択されていない場合
  if (playerCard == -1) {

    text("カードを左クリックして選択してください",width / 2,585);
  } else {
    
    // カードが選択されている場合
    text("選択したカードをもう一度左クリックで決定！",width / 2,585);
  }
}

// ========================================
// プレイヤーの手札を表示
// ========================================

void drawPlayerCards() {

  // 表示するカードの数
  int count = 0;

  // 全カードを確認
  for (int i = 0; i < playerCards.length; i++) {

    // 使用済みカードは表示しない
    if (playerUsed[i]) {
      continue;
    }

    // カードの位置
    float x = 120 + count * 140;
    float y = 525;

    // ========================================
    // 選択中のカード
    // ========================================

    if (i == playerCard) {

      // 選択中は黄色い枠
      stroke(255, 220, 50);
      strokeWeight(5);
    } else {

      // 通常のカード
      stroke(255);
      strokeWeight(2);
    }

    // カードを描画
    drawCard(playerCards[i],x,y,100,55);

    // 次のカードへ
    count++;
  }

  // 線の太さを戻す
  strokeWeight(1);
}

// ========================================
// カードを描画
// ========================================

void drawCard(
  String name,
  float x,
  float y,
  float w,
  float h
) {

  // 四角形を中央基準にする
  rectMode(CENTER);

  // カードの色
  fill(245, 240, 220);

  // カード本体
  rect(x,y,w,h,10);

  // カード名
  fill(30);
  textSize(22);

  text(name,x,y);
}

// ========================================
// 裏向きカード
// ========================================

void drawBack(
  float x,
  float y,
  float w,
  float h
) {

  // 四角形を中央基準にする
  rectMode(CENTER);

  // カードの色
  fill(80, 30, 30);

  // カード本体
  rect(x,y,w,h,10);

  // 「？」を表示
  fill(255, 210, 60);
  textSize(28);

  text("？",x,y);
}

// ========================================
// マウス操作
// ========================================

void mousePressed() {

  // ========================================
  // 陣営選択
  // ========================================

  if (side.equals("")) {

    // ----------------------------------------
    // 皇帝側をクリック
    // ----------------------------------------

    if (
      mouseX > 140 &&
      mouseX < 360 &&
      mouseY > 270 &&
      mouseY < 370
    ) {

      side = "皇帝";

      // ゲームを初期化
      initializeGame();

      return;
    }

    // ----------------------------------------
    // 奴隷側をクリック
    // ----------------------------------------

    if (
      mouseX > 440 &&
      mouseX < 660 &&
      mouseY > 270 &&
      mouseY < 370
    ) {

      side = "奴隷";

      // ゲームを初期化
      initializeGame();
      return;
    }
    return;
  }

  // ========================================
  // ゲーム終了後
  // ========================================

  if (round >= 5) {

    // 「最初の画面に戻る」ボタン
    if (
      mouseX > width / 2 - 110 &&
      mouseX < width / 2 + 110 &&
      mouseY > 472 &&
      mouseY < 528
    ) {

      // 陣営をリセット
      side = "";

      // カードをリセット
      playerCard = -1;
      playerShownCard = -1;
      enemyCard = -1;

      // ラウンドをリセット
      round = 0;

      // スコアをリセット
      playerWin = 0;
      enemyWin = 0;
      drawCount = 0;

      // 結果をリセット
      result = "";
    }
    return;
  }

  // ========================================
  // カード選択
  // ========================================

  int count = 0;

  // 手札を確認
  for (int i = 0; i < playerCards.length; i++) {

    // 使用済みカードは無視
    if (playerUsed[i]) {
      continue;
    }

    // カードの位置
    float x = 120 + count * 140;

    // ========================================
    // カードがクリックされたか
    // ========================================

    if (
      mouseX > x - 50 &&
      mouseX < x + 50 &&
      mouseY > 497 &&
      mouseY < 553
    ) {

      // ======================================
      // まだカードを選択していない
      // ======================================

      if (playerCard == -1) {

        // カードを選択
        playerCard = i;
        return;
      }

      // ======================================
      // 選択中のカードをもう一度クリック
      // ======================================

      if (playerCard == i) {

        // 勝負を決定
        playRound();
        return;
      }

      // ======================================
      // 別のカードをクリック
      // ======================================

      // 選択カードを変更
      playerCard = i;
      return;
    }

    // 次のカードへ
    count++;
  }
}

// ========================================
// 1ラウンドを実行
// ========================================

void playRound() {

  // ========================================
  // 相手の残りカードを調べる
  // ========================================

  int[] available =
    new int[enemyCards.length];

  int count = 0;

  for (
    int i = 0;
    i < enemyCards.length;
    i++
  ) {

    // 使用されていないカード
    if (!enemyUsed[i]) {
      available[count] = i;
      count++;
    }
  }

  // ========================================
  // 相手のカードをランダムに選ぶ
  // ========================================

  int randomIndex =
    int(random(count));

  enemyCard =
    available[randomIndex];

  // ========================================
  // 自分のカードを保存
  // ========================================

  playerShownCard =
    playerCard;

  // ========================================
  // カードを使用済みにする
  // ========================================

  playerUsed[playerCard] = true;

  enemyUsed[enemyCard] = true;

  // ========================================
  // 勝敗判定
  // ========================================

  result = judge(
    playerCards[playerCard],
    enemyCards[enemyCard]
  );

  // ========================================
  // スコアを更新
  // ========================================

  if (result.equals("YOU WIN!")) {
    playerWin++;
  } else if (result.equals("YOU LOSE...")) {
    enemyWin++;
  } else {
    drawCount++;
  }

  // ========================================
  // ラウンドを進める
  // ========================================

  round++;

  // 選択状態を解除
  playerCard = -1;
}

// ========================================
// ゲーム初期化
// ========================================

void initializeGame() {

  // ========================================
  // 皇帝側
  // ========================================

  if (side.equals("皇帝")) {
    playerCards = new String[] {
      "皇帝",
      "市民",
      "市民",
      "市民",
      "市民"
    };

    enemyCards = new String[] {
      "奴隷",
      "市民",
      "市民",
      "市民",
      "市民"
    };

  // ========================================
  // 奴隷側
  // ========================================

  } else {
    playerCards = new String[] {
      "奴隷",
      "市民",
      "市民",
      "市民",
      "市民"
    };

    enemyCards = new String[] {
      "皇帝",
      "市民",
      "市民",
      "市民",
      "市民"
    };
  }

  // ========================================
  // 使用済み状態を初期化
  // ========================================

  playerUsed =
    new boolean[playerCards.length];

  enemyUsed =
    new boolean[enemyCards.length];

  // ========================================
  // その他の状態を初期化
  // ========================================

  playerCard = -1;

  playerShownCard = -1;

  enemyCard = -1;

  round = 0;

  playerWin = 0;

  enemyWin = 0;

  drawCount = 0;

  result = "";
}

// ========================================
// 勝敗判定
// ========================================

String judge(
  String player,
  String enemy
) {

  // ========================================
  // 同じカード
  // ========================================

  if (player.equals(enemy)) {
    return "DRAW";
  }

  // ========================================
  // 皇帝 vs 市民
  // ========================================

  if (
    player.equals("皇帝") &&
    enemy.equals("市民")
  ) {
    return "YOU WIN!";
  }

  // ========================================
  // 市民 vs 奴隷
  // ========================================

  if (
    player.equals("市民") &&
    enemy.equals("奴隷")
  ) {

    return "YOU WIN!";
  }

  // ========================================
  // 奴隷 vs 皇帝
  // ========================================

  if (
    player.equals("奴隷") &&
    enemy.equals("皇帝")
  ) {

    return "YOU WIN!";
  }

  // ========================================
  // それ以外は負け
  // ========================================

  return "YOU LOSE...";
}
